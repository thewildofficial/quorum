# Copy to your environment. Secrets never go in git.

PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/quorum

# Google OAuth (see README "Google OAuth configuration")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI defaults to <host>/api/auth/google/callback; set explicitly in production:
# GOOGLE_REDIRECT_URI=https://your-domain/api/auth/google/callback

# Only Google accounts from this workspace domain may sign in
ALLOWED_GOOGLE_DOMAIN=sst.scaler.com

# Comma-separated SST emails allowed to publish/manage events
ORGANIZER_EMAILS=you@sst.scaler.com

# COOKIE_SECURE=false   # only for plain-http LAN testing
