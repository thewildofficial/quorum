# Copy to .env and adjust. All values have safe local defaults; none are secrets you must fill in.

# Port the server listens on
PORT=4000

# Where the SQLite database file lives (created automatically)
DATABASE_PATH=./data/deliberate.db

# Demo seed account (only used by `npm run seed`). Change or skip seeding for real use.
SEED_EMAIL=demo@deliberate.local
SEED_PASSWORD=demo-password-123

# Set to "false" when serving over plain http on a LAN (cookies are Secure in production by default)
# COOKIE_SECURE=false
